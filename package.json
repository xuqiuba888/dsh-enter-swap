{
  "name": "dsh-enter-swap",
  "description": "DSH (DeepSeek Harness) web plugin: Enter inserts a newline, Shift+Enter sends the message. 极简按键互换：Enter=换行，Shift+Enter=发送。",
  "version": "0.1.3",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "composer",
    "keybinding",
    "enter",
    "newline",
    "web-plugin"
  ],
  "dsh": {
    "compatibility": {
      "node": ">=20"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuqiuba888/dsh-enter-swap.git"
  },
  "homepage": "https://github.com/xuqiuba888/dsh-enter-swap",
  "bugs": {
    "url": "https://github.com/xuqiuba888/dsh-enter-swap/issues"
  }
}
